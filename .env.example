# ==============================================================================
# SEO Analyzer (.env.example)
# 公開用環境変数テンプレート（機密情報はダミー表記）
# ==============================================================================

NODE_ENV="production"
PORT="5600"
HOST="127.0.0.1"
HOSTNAME="127.0.0.1"

# Public App URLs
NEXT_PUBLIC_APP_URL="https://seo.n-n.tokyo"
NEXT_PUBLIC_DOMAIN="seo.n-n.tokyo"
NEXTAUTH_URL="https://seo.n-n.tokyo"
NEXTAUTH_SECRET="replace-with-secure-random-secret"

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/seo?schema=public"

# Redis (BullMQ queue & cache)
REDIS_URL="redis://127.0.0.1:6379"

# Encryption key for tokens (32-byte hex)
ENCRYPTION_MASTER_KEY="replace-with-32-byte-hex-key"

# Google APIs (ユーザー各自で取得・設定)
# Search Console: ビルド時に設定。確認後も削除しないでください。
GOOGLE_SITE_VERIFICATION=""
# GA4: ビルド時に設定。未設定の場合は計測タグを出力しません。
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Google AdSense: 公開IDですが、サイトごとの設定をソースコードから分離します。
# NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID は ca-pub-、GOOGLE_ADSENSE_PUBLISHER_ID は pub- で始まります。
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=""
GOOGLE_ADSENSE_PUBLISHER_ID=""
# 手動配置するレスポンシブ広告ユニットの数字ID。未設定なら広告枠を出力しません。
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_ID=""
GOOGLE_PAGESPEED_API_KEY=""
# 広告など収益を伴う用途ではSafe BrowsingではなくWeb Riskを使用します。
GOOGLE_WEB_RISK_API_KEY=""
GOOGLE_REDIRECT_URI="https://seo.n-n.tokyo/api/v1/integrations/google/callback"
GEMINI_MODEL="gemini-3.8-flash"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""

# Email verification (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SEO Analyzer <no-reply@seo.n-n.tokyo>"
SENDMAIL_PATH="/usr/sbin/sendmail"
ALERT_MONITOR_INTERVAL_MS="900000"

# GitHub deploy webhook (required in production)
DEPLOY_WEBHOOK_SECRET="replace-with-secure-random-secret"
# Development-only escape hatch. Never enable in production.
ALLOW_UNSIGNED_DEPLOY_WEBHOOK="false"
